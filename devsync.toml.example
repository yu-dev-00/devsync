[connection]
host = "remote-pc"
user = "user"
port = 22
agent_path = "C:\\tools\\devsync.exe"

[paths]
local_dir = "."
remote_dir = "C:\\work\\project"

[commands]
build = "powershell -NoProfile -ExecutionPolicy Bypass -File .\\build.ps1"
run = "powershell -NoProfile -ExecutionPolicy Bypass -File .\\run.ps1"
test = "powershell -NoProfile -ExecutionPolicy Bypass -File .\\test.ps1"

[sync]
# Excludes apply to the local upload scan. NOTE: with `devsync sync --delete`,
# excluded paths (e.g. bin, obj, build, dist, artifacts) are treated as
# remote-only and will be DELETED from remote_dir. Use plain `devsync sync` to
# avoid deleting remote build outputs. Forced excludes (devsync.toml, .git,
# .devsync) are always protected.
exclude = [
  ".git",
  ".devsync",
  "devsync.toml",
  "bin",
  "obj",
  "build",
  "dist",
  "logs",
  "artifacts",
  "node_modules",
  ".vs",
  ".vscode"
]
